# انسخ الملف ده باسم .env
# لو بتستخدم docker-compose.yml اللي في المشروع، القيمة دي شغالة زي ما هي.
DATABASE_URL="postgresql://tasleem:tasleem@localhost:5432/tasleem?schema=public"

# اختياري: لو تحميل Chrome الخاص بـ Puppeteer فشل وقت npm install (التفاصيل في README)،
# فعّل السطر ده بمسار Chrome اللي على جهازك:
# PUPPETEER_EXECUTABLE_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
